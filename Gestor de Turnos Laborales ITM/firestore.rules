rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    // Colección de empleados
    match /empleados/{empleadoId} {
      allow read, write: if estaAutenticado();
    }

    // Colección de turnos del catálogo
    match /turnos/{turnoId} {
      allow read, write: if estaAutenticado();
    }

    // Colección de asignaciones diarias / malla semanal
    match /asignaciones/{asignacionId} {
      allow read, write: if estaAutenticado();
    }

    // Colección de marcaciones y control de asistencia
    match /asistencia/{asistenciaId} {
      allow read, write: if estaAutenticado();
    }

    // Colección de novedades operativas e incapacidades
    match /novedades/{novedadId} {
      allow read, write: if estaAutenticado();
    }

    // Colección de solicitudes de intercambio de turno
    match /solicitudes_cambio/{solicitudId} {
      allow read, write: if estaAutenticado();
    }

    // Colección de notificaciones de incumplimiento
    match /incumplimientos/{incumplimientoId} {
      allow read, write: if estaAutenticado();
    }
  }
}
